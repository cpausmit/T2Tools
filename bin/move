#!/bin/bash
#---------------------------------------------------------------------------------------------------
# Move a Tier-2 file/directory.  Usage: move <source> <target>
#---------------------------------------------------------------------------------------------------
args=()
for arg in "$@"
do
  [ "${arg:0:2}" == "--" ] || args+=("$arg")
done
if [ ${#args[@]} != 2 ]
then
  echo " Usage: move <source> <target>"
  exit 1
fi
t2tools.py --action=mv --source="${args[0]}" --target="${args[1]}"
rc=$?
echo "rc: $rc"
exit $rc
