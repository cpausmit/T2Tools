#!/bin/bash
#---------------------------------------------------------------------------------------------------
# Make a Tier-2 directory.  Usage: makedir <path> [ --p ]
#---------------------------------------------------------------------------------------------------
options=""
paths=""
for arg in "$@"
do
  case "$arg" in
    --p|-p) options="-p" ;;
    --help) echo " Usage: makedir <path> [ --p ]"; exit 0 ;;
    --*)    ;;
    *)      paths="$paths $arg" ;;
  esac
done
rc=0
for path in $paths
do
  t2tools.py --action=mkdir --options="$options" --source="$path" || rc=1
done
exit $rc
