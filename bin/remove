#!/usr/bin/env python3
#---------------------------------------------------------------------------------------------------
# Script to remove Tier-2 files, optionally also remove them from the catalog.
#
# Author: C.Paus                                                                      (May 06, 2010)
#---------------------------------------------------------------------------------------------------
import os,sys,getopt,subprocess

def debugPrint(text,debug):
    if debug:
        print(' DEBUG: ' + text)

def execute(cmd,debug):
    debugPrint(cmd,debug)
    os.system(cmd)

def remove(source,debug):
    cmd = ['t2tools.py','--action=rm','--source=' + source]
    debugPrint('  -> removing with: ' + ' '.join(cmd),debug)
    status = subprocess.call(cmd)
    if status != 0:
        print(' ERROR: remove returned error %d (on %s)'%(status,' '.join(cmd)))

    return status

def removeCatalog(source,debug):
    pid = "%d"%os.getpid()
    # which catalog is this one in?
    catalogDir = '/home/cmsprod/catalog/t2mit'
    # now get the dataset and the book
    f = source.split('/')
    file = f[-1]
    dataset = f[-2]
    book = f[-4] + '/' + f[-3]
    dir = catalogDir + '/' + book + '/' + dataset

    # now remove the particular file from the record
    cmd = 'cat ' + dir + '/RawFiles.?? | sort -u | grep -v ' + file + ' > /tmp/RawFiles.00.' + pid
    execute(cmd,debug)
    cmd = 'rm ' + dir + '/RawFiles.??'
    execute(cmd,debug)
    cmd = 'mv /tmp/RawFiles.00.' + pid + ' ' + dir + '/RawFiles.00'
    execute(cmd,debug)
    cmd = 'cat ' + dir + '/Files | grep -v ' + file + ' > /tmp/Files.' + pid
    execute(cmd,debug)
    cmd = 'mv /tmp/Files.' + pid + ' ' + dir + '/Files'
    execute(cmd,debug)

    return

#===================================================================================================
# Main starts here
#===================================================================================================
usage =  "Usage: remove  <source> [ <source> ... ]\n"
usage += "               --catalog\n"
usage += "               --debug\n"
usage += "               --help\n"

valid = ['catalog','debug','help']
try:
    opts, args = getopt.gnu_getopt(sys.argv[1:], "", valid)
except getopt.GetoptError as ex:
    print(usage)
    print(str(ex))
    sys.exit(1)

catalog = False
debug   = False
for opt, arg in opts:
    if   opt == '--help':
        print(usage)
        sys.exit(0)
    elif opt == '--debug':
        debug   = True
    elif opt == '--catalog':
        catalog = True

status = 0
for source in args:
    debugPrint(' Next File: ' + source,debug)
    rc = remove(source,debug)
    status += rc
    # remove also the catalog entry
    if catalog and rc == 0:
        removeCatalog(source,debug)

sys.exit(1 if status != 0 else 0)
