#!/bin/bash
#---------------------------------------------------------------------------------------------------
# Change permissions of Tier-2 paths, same format as chmod.
# Usage: changemod --options="-R a+r" <path> [ <path> ... ]
#---------------------------------------------------------------------------------------------------
options=""
paths=""
for arg in "$@"
do
  case "$arg" in
    --options=*) options="${arg#--options=}" ;;
    --help)      echo " Usage: changemod --options=\"-R a+r\" <path> ..."; exit 0 ;;
    --*)         ;;
    *)           paths="$paths $arg" ;;
  esac
done
rc=0
for path in $paths
do
  t2tools.py --action=chmod --options="$options" --source="$path" || rc=1
done
exit $rc
