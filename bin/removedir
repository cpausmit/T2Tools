#!/bin/bash
#---------------------------------------------------------------------------------------------------
# Remove a directory recursively: Tier-2 paths (/cms/..., root://..., /ceph/...) on the Tier-2, any
# other path locally.  Usage: removedir <path> [ <path> ... ] [ --debug ]
#---------------------------------------------------------------------------------------------------
debug=0
paths=()
for arg in "$@"
do
  case "$arg" in
    --debug) debug=1 ;;
    --help)  echo " Usage: removedir <path> [ <path> ... ] [ --debug ]"; exit 0 ;;
    --*)     ;;
    *)       paths+=("$arg") ;;
  esac
done
rc=0
for path in "${paths[@]}"
do
  case "$path" in
    /cms/*|/mnt/hadoop/cms/*|root://*|/ceph/*)
      [ $debug == 1 ] && echo " DEBUG: Identified a tier-2 path: $path"
      t2tools.py --action=rmr --source="$path" || rc=1 ;;
    *)
      [ $debug == 1 ] && echo " DEBUG: Identified a local path: $path"
      rm -rf "$path" || rc=1 ;;
  esac
done
exit $rc
