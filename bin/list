#!/bin/bash
#---------------------------------------------------------------------------------------------------
# List one or more Tier-2 directories/files (format: <F|D>:<size> <path>).
# Usage: list <path> [ <path> ... ] [ --options=-l ]
#---------------------------------------------------------------------------------------------------
options=""
paths=()
for arg in "$@"
do
  case "$arg" in
    --options=*) options="${arg#--options=}" ;;
    --*)         ;;
    *)           paths+=("$arg") ;;
  esac
done
rc=0
for path in "${paths[@]}"
do
  t2tools.py --action=ls --options="$options" --source="$path" || rc=1
done
exit $rc
